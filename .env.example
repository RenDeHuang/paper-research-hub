APP_ENV=development
DATABASE_URL=postgres://paper_hub:paper_hub_local@localhost:5432/paper_hub?sslmode=disable

# Only for local development. Production must inject an independent secret of
# at least 32 bytes through its secret manager and keep it stable across API replicas.
CATALOG_CURSOR_SECRET=development-only-catalog-cursor-secret-change-me

# Docker Compose local database and published ports.
POSTGRES_DB=paper_hub
POSTGRES_USER=paper_hub
POSTGRES_PASSWORD=paper_hub_local
POSTGRES_PUBLISHED_PORT=5432
DOCKER_DATABASE_URL=postgres://paper_hub:paper_hub_local@postgres:5432/paper_hub?sslmode=disable
API_PUBLISHED_PORT=8080
WEB_PUBLISHED_PORT=3000

API_HOST=0.0.0.0
API_PORT=8080
API_READ_HEADER_TIMEOUT=5s
API_READ_TIMEOUT=15s
API_WRITE_TIMEOUT=30s
API_IDLE_TIMEOUT=1m
API_SHUTDOWN_TIMEOUT=10s
API_MAX_HEADER_BYTES=1048576
# Exact browser origins allowed to read API responses. Use a comma-separated
# allowlist without paths, queries, credentials, or wildcards.
API_CORS_ALLOWED_ORIGINS=http://localhost:3000

DB_MIN_CONNS=2
DB_MAX_CONNS=16
DB_CONNECT_TIMEOUT=5s
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=30s

WORKER_CONCURRENCY=4
WORKER_BATCH_SIZE=100
WORKER_POLL_INTERVAL=5s
WORKER_MAX_RETRIES=5
WORKER_MAX_WAIT=5m

NUXT_HOST=0.0.0.0
NUXT_PORT=3000
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Source credentials are validated only by the command that uses that source.
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_TIMEOUT=30s
OPENALEX_MAX_RETRIES=5
OPENALEX_MAX_WAIT=1m
OPENALEX_BATCH_SIZE=100
# Both values are required by openalex-sync because current list/search API
# requests consume an authenticated OpenAlex API budget.
# OPENALEX_CONTACT_EMAIL=research@example.com
# OPENALEX_API_KEY=replace-with-openalex-api-key

PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov
PUBMED_TIMEOUT=30s
PUBMED_MAX_RETRIES=5
PUBMED_MAX_WAIT=1m
PUBMED_BATCH_SIZE=100
# NCBI_TOOL=paper-hub
# NCBI_EMAIL=research@example.com
# NCBI_API_KEY=

CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_TIMEOUT=30s
CROSSREF_MAX_RETRIES=5
CROSSREF_MAX_WAIT=1m
CROSSREF_BATCH_SIZE=100
# CROSSREF_CONTACT_EMAIL=research@example.com

PMC_BASE_URL=https://www.ncbi.nlm.nih.gov/pmc
PMC_TIMEOUT=30s
PMC_MAX_RETRIES=5
PMC_MAX_WAIT=1m
PMC_BATCH_SIZE=100
# PMC_CONTACT_EMAIL=research@example.com

SPRINGER_NATURE_BASE_URL=https://api.springernature.com
SPRINGER_NATURE_TIMEOUT=30s
SPRINGER_NATURE_MAX_RETRIES=5
SPRINGER_NATURE_MAX_WAIT=1m
SPRINGER_NATURE_BATCH_SIZE=100
# SPRINGER_NATURE_API_KEY=
# SPRINGER_NATURE_CONTACT_EMAIL=research@example.com

ELSEVIER_BASE_URL=https://api.elsevier.com
ELSEVIER_TIMEOUT=30s
ELSEVIER_MAX_RETRIES=5
ELSEVIER_MAX_WAIT=1m
ELSEVIER_BATCH_SIZE=100
# ELSEVIER_API_KEY=
# ELSEVIER_CONTACT_EMAIL=research@example.com

# Both values are required by `paper-hub-worker import jcr`.
# JCR_IMPORT_PATH must be an explicitly supplied, user-authorized CSV.
# JCR_SOURCE_LICENSE must identify the authorization or license basis for that export.
# No metric or license fallback exists.
# JCR_IMPORT_PATH=/absolute/path/to/authorized-jcr-export.csv
# JCR_SOURCE_LICENSE=organization-authorized-jcr-export

{
  "name": "@paper-hub/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "generate:api-types": "node scripts/generate-openapi-types.mjs",
    "check:api-types": "node scripts/generate-openapi-types.mjs --check",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.e2e.config.ts",
    "test:e2e": "playwright test",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "4.4.8",
    "vue": "3.5.39",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.16.0",
    "@nuxt/test-utils": "3.23.0",
    "@playwright/test": "1.61.1",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.7.0",
    "happy-dom": "20.10.6",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "vue-tsc": "2.2.12",
    "yaml": "2.9.0"
  }
}
